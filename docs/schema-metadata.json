  "checks": [
    [
      "chk_account_state",
      "(`state` in (_utf8mb4\\'PENDING_ACTIVATION\\',_utf8mb4\\'ACTIVE\\',_utf8mb4\\'DISABLED\\'))"
    ],
    [
      "chk_asset_inspections_completion",
      "(((`status` = _utf8mb4\\'SCHEDULED\\') and (`inspected_by_user_id` is null) and (`completed_date` is null)) or ((`status` in (_utf8mb4\\'PASSED\\',_utf8mb4\\'FAILED\\')) and (`inspected_by_user_id` is not null) and (`notes` is not null) and (`completed_date` is not null)))"
    ],
    [
      "chk_asset_inspections_status",
      "(`status` in (_utf8mb4\\'SCHEDULED\\',_utf8mb4\\'PASSED\\',_utf8mb4\\'FAILED\\'))"
    ],
    [
      "chk_assets_status",
      "(`status` in (_utf8mb4\\'ACTIVE\\',_utf8mb4\\'UNDER_MAINTENANCE\\',_utf8mb4\\'OUT_OF_SERVICE\\',_utf8mb4\\'RETIRED\\'))"
    ],
    [
      "chk_complaints_priority",
      "(`priority` in (_utf8mb4\\'LOW\\',_utf8mb4\\'MEDIUM\\',_utf8mb4\\'HIGH\\',_utf8mb4\\'CRITICAL\\'))"
    ],
    [
      "chk_complaints_status",
      "(`status` in (_utf8mb4\\'SUBMITTED\\',_utf8mb4\\'ACCEPTED\\',_utf8mb4\\'REJECTED\\',_utf8mb4\\'WORK_ORDER_CREATED\\',_utf8mb4\\'RESOLVED\\',_utf8mb4\\'WITHDRAWN\\'))"
    ],
    [
      "chk_hold_clearance",
      "(((`cleared_at` is null) and (`cleared_by_user_id` is null) and (`clearance_reason` is null) and (`passing_inspection_id` is null) and (`verified_work_order_id` is null)) or ((`cleared_at` is not null) and (`cleared_by_user_id` is not null) and (`clearance_reason` is not null) and (char_length(trim(`clearance_reason`)) > 0) and (((`passing_inspection_id` is not null) and (`verified_work_order_id` is null)) or ((`passing_inspection_id` is null) and (`verified_work_order_id` is not null)))))"
    ],
    [
      "chk_manual_lifecycle",
      "(`manual_lifecycle` in (_utf8mb4\\'ACTIVE\\',_utf8mb4\\'OUT_OF_SERVICE\\',_utf8mb4\\'RETIRED\\'))"
    ],
    [
      "chk_note_body",
      "(char_length(trim(`body`)) between 1 and 2000)"
    ],
    [
      "chk_note_kind",
      "(`kind` in (_utf8mb4\\'COMMENT\\',_utf8mb4\\'ACCEPT_REASON\\',_utf8mb4\\'REJECT_REASON\\',_utf8mb4\\'WITHDRAW_REASON\\',_utf8mb4\\'REOPEN_REASON\\'))"
    ],
    [
      "chk_note_role",
      "(`author_role` in (_utf8mb4\\'REQUESTER\\',_utf8mb4\\'TECHNICIAN\\',_utf8mb4\\'ADMINISTRATOR\\'))"
    ],
    [
      "chk_preventive_schedule_frequency",
      "(`frequency_days` > 0)"
    ],
    [
      "chk_preventive_schedule_status",
      "(`status` in (_cp850\\'ACTIVE\\',_cp850\\'PAUSED\\'))"
    ],
    [
      "chk_repair_review_kind",
      "(`kind` in (_utf8mb4\\'RETURN\\',_utf8mb4\\'VERIFY\\'))"
    ],
    [
      "chk_repair_review_reason",
      "(((`kind` = _utf8mb4\\'RETURN\\') and (`reason` is not null) and (char_length(trim(`reason`)) between 1 and 2000)) or ((`kind` = _utf8mb4\\'VERIFY\\') and (`reason` is null)))"
    ],
    [
      "chk_repair_review_role",
      "(`author_role` = _utf8mb4\\'ADMINISTRATOR\\')"
    ],
    [
      "chk_submission_author",
      "(((`submitted_by_user_id` is null) and (`author_name` is null) and (`author_role` is null)) or ((`submitted_by_user_id` is not null) and (`author_name` is not null) and (`author_role` is not null) and (`author_role` = _utf8mb4\\'TECHNICIAN\\')))"
    ],
    [
      "chk_submission_number",
      "(`submission_number` > 0)"
    ],
    [
      "chk_users_role",
      "(`role` in (_cp850\\'REQUESTER\\',_cp850\\'TECHNICIAN\\',_cp850\\'ADMINISTRATOR\\'))"
    ],
    [
      "chk_work_orders_status",
      "(`status` in (_utf8mb4\\'ASSIGNED\\',_utf8mb4\\'IN_PROGRESS\\',_utf8mb4\\'COMPLETED\\',_utf8mb4\\'RETURNED\\',_utf8mb4\\'VERIFIED\\'))"
    ]
  ]
}
